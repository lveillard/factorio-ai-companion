# Generated from config/settings.ts; copy to .env and edit your values.

# HTTP bind address; use 0.0.0.0 inside Docker
COMPANION_HOST=127.0.0.1

# Dashboard and MCP Streamable HTTP port
COMPANION_PORT=3210

# External HTTPS origin when behind a reverse proxy
COMPANION_PUBLIC_URL=

# Required for non-loopback hosting (at least 32 characters); bearer token for MCP
COMPANION_ACCESS_TOKEN=

# Persistent logs, chat, feedback database and isolated Codex credentials
COMPANION_DATA_DIR=.local

# owner/repo for automatic feedback issues; empty keeps reports local
FEEDBACK_GITHUB_REPOSITORY=

# GitHub token with Issues read/write access; falls back to local gh login
FEEDBACK_GITHUB_TOKEN=

# Coalesce feedback and refresh GitHub issue state at this interval
FEEDBACK_SYNC_INTERVAL_MS=60000

# Separate feedback tool allowance per Codex turn, even after game tools run out
MAX_FEEDBACK_CALLS=3

# RCON server hostname/IP; host.docker.internal for a host game
FACTORIO_HOST=127.0.0.1

# Factorio RCON port (local or remote)
FACTORIO_RCON_PORT=34198

# Must match the Factorio RCON password
FACTORIO_RCON_PASSWORD=factorio

# Optional Factorio executable for installation diagnostics and isolated game tests
FACTORIO_BINARY=

# Optional Factorio mods directory; otherwise inferred from this operating system
FACTORIO_MOD_DIR=

# Mod Portal key with Upload Mods scope; used only by mod:publish
FACTORIO_MOD_UPLOAD_API_KEY=

# World and chat refresh interval
POLL_INTERVAL_MS=2000

# Maximum time per Codex turn before pausing
TURN_TIMEOUT_MS=180000

# Maximum game tools per Codex turn
MAX_TOOL_CALLS=64

# Maximum automatic follow-up turns per request after native game jobs finish
MAX_JOB_CONTINUATIONS=12

# Recheck a native job after this delay even if it still reports active
JOB_REVIEW_TIMEOUT_MS=300000

# Durable chat queue capacity
MAX_QUEUED_MESSAGES=50
